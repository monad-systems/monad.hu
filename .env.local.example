# Public env vars (safe to expose to browser)

# Base URL of the contact endpoint (services/contact), without a trailing slash.
# It serves the ALTCHA challenge and accepts the contact form. Leave empty to
# show the form as unavailable.
NEXT_PUBLIC_CONTACT_API_URL=

# Umami analytics. Both must be set for the tracker to load.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
