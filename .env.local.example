# Public env vars (safe to expose to browser)
# Used by the contact form submission on the homepage.

# Google reCAPTCHA v3 site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Apps Script Web App URL (must accept POST with JSON body)
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Umami analytics website ID (leave empty to disable tracking)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Umami script URL; only needed for a self-hosted instance
# (defaults to https://cloud.umami.is/script.js)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
